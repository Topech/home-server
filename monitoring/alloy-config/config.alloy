// REF: https://grafana.com/docs/alloy/latest/tutorials/send-logs-to-loki/

livedebugging {
  enabled = true
}


local.file_match "local_files" {
  // NOTE: all non-dunder fields are added as labels
  path_targets = [
    {"__path__" = "/host/var/log/*.log", job = "local.file_match.local_files"},
    {"__path__" = "/host/var/log/jellyfin/*.log", job = "local.file_match.local_files"},
  ]
  sync_period = "5s"
}
 

loki.source.file "host_var_log_scrape" {
  targets    = local.file_match.local_files.targets
  forward_to = [loki.write.grafana_loki.receiver]
  tail_from_end = true
}


loki.source.journal "host_journal_scrape" {
  path = "/host/run/log/journal"
  forward_to = [loki.write.grafana_loki.receiver]
  relabel_rules = loki.relabel.journal_unit_relabel.rules
}


loki.relabel "journal_unit_relabel" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}


// loki.process "filter_logs" {
//   stage.drop {
//     source = ""
//     expression  = ".*Connection closed by authenticating user root"
//     drop_counter_reason = "noisy"
//   }
//   forward_to = [loki.process.local_file_label.receiver]
// }



loki.write "grafana_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"

    // basic_auth {
    //  username = "admin"
    //  password = "admin"
    // }
  }
}


